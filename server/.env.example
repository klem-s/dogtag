# ton nom de domaine qui pointe vers le serveur (un sous-domaine DuckDNS gratuit marche)
DOMAIN=stats.mondomaine.fr
# jeton partagé avec dogtag (config.toml : [metrics] token et [push] token) - mets une longue chaîne au hasard
DOGTAG_TOKEN=change-moi-par-une-longue-chaine
GRAFANA_PASSWORD=change-moi
# true pour que le tableau de bord soit visible sans se connecter
GRAFANA_PUBLIC=false
