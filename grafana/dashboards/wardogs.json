{
 "uid": "dogtag-wardogs",
 "title": "WARDOGS - dogtag",
 "editable": true,
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "10s",
 "timezone": "browser",
 "tags": [
  "wardogs",
  "dogtag"
 ],
 "templating": {
  "list": [
   {
    "name": "player",
    "label": "Joueur",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "vm"
    },
    "query": {
     "query": "label_values(wardogs_balance, player)",
     "refId": "v"
    },
    "definition": "label_values(wardogs_balance, player)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2,
    "allValue": ".*"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Solde en jeu",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "last_over_time(wardogs_balance{player=~\"$player\"}[30d])",
     "instant": true,
     "legendFormat": "{{player}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
